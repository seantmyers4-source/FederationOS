{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.federationos.example/schema-binding-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "record_id", "authority", "status", "bindings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_id": {"const": "FREP-SBM-001"},
    "authority": {"const": "OS Federation Engineering Implementation Authority"},
    "status": {"const": "candidate-pending-registry-verification"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "glob": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "pattern": "^registry/schemas/.+\\.schema\\.json$"},
          "role": {"enum": ["record", "template"]},
          "required": {"type": "boolean"}
        },
        "oneOf": [{"required": ["path"], "not": {"required": ["glob"]}}, {"required": ["glob"], "not": {"required": ["path"]}}],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
